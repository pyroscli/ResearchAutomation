{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchbot.local/schema/research-result.json",
  "title": "ResearchResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "summary", "sources"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "The user research query, restated clearly."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "2-5 sentence overview of what was found across sources."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "url",
        "source_name",
        "reliability",
        "relevance_score",
        "verified",
        "summary"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["paper", "blog", "video", "patent", "repository"]
        },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 8 },
        "source_name": {
          "type": "string",
          "description": "Publisher or index, e.g. arXiv, ACM, YouTube, a blog domain."
        },
        "reliability": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "verified": {
          "type": "boolean",
          "description": "true only if the original source was opened and inspected."
        },
        "unavailable_reason": {
          "type": ["string", "null"],
          "description": "Required when verified is false. Never invent content instead."
        },
        "canonical_id": {
          "type": ["string", "null"],
          "description": "DOI, arXiv id, YouTube video id, patent number, or normalized URL."
        },
        "authors": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "published_date": {
          "type": ["string", "null"],
          "description": "ISO date or year. null if not verified."
        },
        "doi": { "type": ["string", "null"] },
        "arxiv_id": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"] },
        "duration": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "summary": { "$ref": "#/$defs/source_summary" }
      }
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tldr"],
      "properties": {
        "tldr": { "type": "string", "minLength": 1 },
        "problem": { "type": ["string", "null"] },
        "approach": { "type": ["string", "null"] },
        "key_findings": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "methodology": { "type": ["string", "null"] },
        "results": { "type": ["string", "null"] },
        "limitations": { "type": ["string", "null"] },
        "why_it_matters": { "type": ["string", "null"] },
        "prerequisites": { "type": ["string", "null"] },
        "difficulty": {
          "type": ["string", "null"],
          "enum": ["beginner", "intermediate", "advanced", "expert", null]
        },
        "main_argument": { "type": ["string", "null"] },
        "important_concepts": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "technical_takeaways": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "key_concepts": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "timestamps": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "label"],
            "properties": {
              "time": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
